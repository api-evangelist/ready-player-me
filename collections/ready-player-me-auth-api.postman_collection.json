  "info": {
    "_postman_id": "311d3dce-5018-4bae-88e8-83b5c4d6cdfe",
    "name": "Ready Player Me Assets Auth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "List, filter, and retrieve Ready Player Me assets — hair, outfits, headwear,\nglasses, facewear, footwear, beards, costumes, and custom assets — that can be\nequipped on avatars. Assets are scoped to an application (`X-APP-ID`) and can be\nfurther filtered to those visible or usable by a specific user.\n\n\nContact Support:\n Name: Ready Player Me Developers",
      "type": "text/plain"
    }
  }
