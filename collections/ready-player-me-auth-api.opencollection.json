{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ready Player Me Assets Auth API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-APP-ID",
      "value": "{{X-APP-ID}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Anonymous User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.readyplayer.me/api/users"
          },
          "docs": "Create Anonymous User"
        },
        {
          "info": {
            "name": "Start Login With Email Code",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.readyplayer.me/api/auth/start",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Start Login With Email Code"
        },
        {
          "info": {
            "name": "Confirm Login Code",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.readyplayer.me/api/auth/login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Confirm Login Code"
        },
        {
          "info": {
            "name": "Refresh Auth Tokens",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.readyplayer.me/api/auth/refresh",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Refresh Auth Tokens"
        },
        {
          "info": {
            "name": "Get Avatar Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.readyplayer.me/v1/auth/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Mint a short-lived token used to render or modify a specific avatar."
        }
      ]
    }
  ],
  "bundled": true
}